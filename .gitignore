# Local configuration and credentials
.env
.env.*
!.env.example
!.env.*.example
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
*.pem
*.key
*.p12
*.pfx

# Dependencies and build output
**/node_modules/
**/.next/
**/out/
**/build/
!source/src/app/api/opencode/build/
!source/src/app/api/opencode/build/route.ts
**/dist/
**/coverage/
**/*.tsbuildinfo

# Local tool state and scratch data
**/.tmp/
**/.netlify/
**/.vercel/
**/.claude-flow/
.impeccable/
**/.impeccable/
**/imagegen-raw/
**/imagegen-sources/
**/runtime/
**/runtime-data/
**/sessions/
# The Workbench sessions endpoint is application code, not runtime session data.
# Re-open only this exact dynamic route directory, keep every other entry ignored,
# and publish the Route Handler itself.
!source/src/app/api/workbench/agents/\[id\]/sessions/
source/src/app/api/workbench/agents/\[id\]/sessions/**
!source/src/app/api/workbench/agents/\[id\]/sessions/route.ts
**/session-data/
**/vault-data/

# Generated output and logs
**/generated/
**/output/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Operating system and editor noise
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
# Known malformed local artifacts; preserve locally but never publish
source/src/components/(\[\])
source/src/components/[{]
