@import "tailwindcss";

/* ─────────────────────────────────────────────────────────────────────
   Agentic OS — Midnight Aubergine design system
   Tokens, typography, paper-grain backdrop, and component primitives
   that match free-claude-code-elegant.html.
   ───────────────────────────────────────────────────────────────────── */

:root {
  /* Midnight Aubergine palette */
  --bg-deep:    #15101a;
  --bg-mid:     #1c1622;
  --bg-card:    #251d2c;
  --bg-elev:    #2e2436;

  --cream:      #f3ebda;
  --cream-soft: #ddd0bb;
  --cream-dim:  #a59783;
  --cream-mute: #6e6353;

  --gold:       #d4a574;
  --gold-soft:  #e6c69a;
  --gold-deep:  #a87f54;

  --emerald:    #5ab896;
  --emerald-dim:#3a8a6e;
  --plum:       #c4607e;
  --rust:       #c97c5e;

  --line:       rgba(212, 165, 116, 0.20);
  --line-soft:  rgba(243, 235, 218, 0.08);
  --line-deep:  rgba(243, 235, 218, 0.04);

  --shadow-1: 0 1px 0 rgba(243, 235, 218, 0.03), 0 8px 24px rgba(0,0,0,0.5);
  --shadow-2: 0 2px 0 rgba(243, 235, 218, 0.04), 0 20px 60px rgba(0,0,0,0.55);

  /* Backwards-compat aliases — existing components reference these. We remap
     them onto the new palette so nothing visibly breaks while we refresh. */
  --bg: var(--bg-deep);
  --bg-2: var(--bg-mid);
  --panel: rgba(37, 29, 44, 0.65);
  --panel-border: var(--line-soft);
  --panel-border-hot: var(--line);
  --fg: var(--cream);
  --fg-dim: var(--cream-soft);
  --fg-dimmer: var(--cream-dim);

  --accent-cyan: var(--emerald);
  --accent-violet: var(--gold);
  --accent-pink: var(--plum);
  --accent-lime: var(--emerald);
  --accent-amber: var(--gold);
  --accent-red: var(--plum);

  --claude: var(--rust);
  --openclaw: var(--plum);
  --hermes: var(--gold-soft);

  --grid: rgba(212, 165, 116, 0.04);
  --glow: 0 0 40px 0;
}

@theme inline {
  --color-background: var(--bg-deep);
  --color-foreground: var(--cream);
  --font-sans: 'Manrope', var(--font-geist-sans);
  --font-mono: 'JetBrains Mono', var(--font-geist-mono);
}

* { box-sizing: border-box; }

html, body {
  background: var(--bg-deep);
  color: var(--cream);
  font-family: 'Manrope', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
  font-weight: 400;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
  font-feature-settings: "ss01", "cv11";
}

body {
  background: var(--bg-deep);
  min-height: 100vh;
  position: relative;
}

/* Paper-grain overlay — fixed, low-opacity, blended for a printed-page feel */
body::before {
  content: "";
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 1;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 0.95  0 0 0 0 0.9  0 0 0 0 0.85  0 0 0 0.035 0'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
  opacity: 0.55;
  mix-blend-mode: overlay;
}

/* Warm ambient gradients sitting beneath everything */
body::after {
  content: "";
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 0;
  background:
    radial-gradient(ellipse 65% 45% at 12% 6%, rgba(212, 165, 116, 0.09), transparent 60%),
    radial-gradient(ellipse 55% 40% at 88% 22%, rgba(201, 124, 94, 0.07), transparent 60%),
    radial-gradient(ellipse 70% 50% at 50% 95%, rgba(196, 96, 126, 0.06), transparent 60%);
}

/* Lift real chrome above the overlays */
main, header, aside, nav, .surface { position: relative; z-index: 2; }

/* ─────────────────────────────────────────────────────────────────────
   Typography primitives
   ───────────────────────────────────────────────────────────────────── */

h1, h2, h3, h4, h5, h6 {
  font-family: 'Bricolage Grotesque', sans-serif;
  font-weight: 500;
  letter-spacing: -0.025em;
  color: var(--cream);
}

code, pre, kbd, samp, .mono {
  font-family: 'JetBrains Mono', ui-monospace, monospace;
}

/* Hand-script accent for numerals, roman numerals, emphasis */
.hand,
.hand-num,
em.hand,
[data-hand="true"] {
  font-family: 'Caveat', cursive;
  font-style: normal;
  font-weight: 500;
  color: var(--gold);
}

/* In headings, <em> automatically becomes the hand-script accent */
h1 em, h2 em, h3 em, h4 em, h5 em, h6 em,
.page-title em, .vital-tile .v em, .status-meta em {
  font-family: 'Caveat', cursive;
  font-style: normal;
  font-weight: 500;
  color: var(--gold);
  font-size: 1.4em;
  line-height: 0.9;
}

/* ─────────────────────────────────────────────────────────────────────
   Eyebrow — `I. ─── Chapter Label` pattern
   ───────────────────────────────────────────────────────────────────── */

.eyebrow {
  display: inline-flex; align-items: center; gap: 14px;
  color: var(--cream-dim); margin-bottom: 18px;
}
.eyebrow .num {
  font-family: 'Caveat', cursive; font-weight: 500;
  font-size: 1.4rem; color: var(--gold); line-height: 0.9;
}
.eyebrow .line {
  width: 32px; height: 1px; background: var(--gold); opacity: 0.6;
}
.eyebrow .label {
  font-family: 'Manrope', sans-serif; font-weight: 600;
  font-size: 0.72rem; letter-spacing: 0.22em; text-transform: uppercase;
  color: var(--cream-dim);
}

.page-title {
  font-family: 'Bricolage Grotesque', sans-serif;
  font-weight: 500; font-size: clamp(1.7rem, 4.5vw, 3.4rem);
  line-height: 1.05; letter-spacing: -0.03em; color: var(--cream);
  margin: 0;
}
.page-subtitle {
  font-family: 'Manrope', sans-serif; font-weight: 400;
  font-size: 1rem; color: var(--cream-dim); margin-top: 12px; line-height: 1.55;
  max-width: 720px;
}

/* ─────────────────────────────────────────────────────────────────────
   Status row (`● Active   28 days remaining`)
   ───────────────────────────────────────────────────────────────────── */
.status-pill {
  display: inline-flex; align-items: center; gap: 8px;
  font-family: 'Manrope', sans-serif; font-weight: 600;
  font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--emerald);
}
.status-pill::before {
  content: "●"; color: var(--emerald);
  text-shadow: 0 0 8px var(--emerald);
}
.status-meta {
  font-family: 'Manrope', sans-serif; font-weight: 500;
  font-size: 0.78rem; letter-spacing: 0.12em; text-transform: uppercase;
  color: var(--cream-dim);
}

/* ─────────────────────────────────────────────────────────────────────
   Mission progress bar
   ───────────────────────────────────────────────────────────────────── */
.pbar {
  width: 100%; height: 4px;
  background: rgba(243, 235, 218, 0.05);
  border-radius: 999px; overflow: hidden;
}
.pbar .fill {
  height: 100%;
  background: linear-gradient(90deg, var(--gold), var(--gold-soft));
  border-radius: 999px;
  box-shadow: 0 0 8px rgba(212, 165, 116, 0.3);
  transition: width 0.4s ease;
}
.pbar-value {
  font-family: 'Caveat', cursive;
  font-size: 1.3rem; color: var(--gold); font-weight: 500;
}

/* ─────────────────────────────────────────────────────────────────────
   Action cards (Mission Control + most surfaces) — generic .surface-card too
   ───────────────────────────────────────────────────────────────────── */
.action-card,
.surface-card {
  background: var(--bg-card);
  border: 1px solid var(--line-soft);
  border-radius: 8px;
  padding: 24px;
  box-shadow: var(--shadow-1);
  transition: border-color 0.2s ease, background 0.2s ease, transform 0.2s ease;
}
.action-card:hover,
.surface-card:hover {
  border-color: var(--line);
  background: var(--bg-elev);
  transform: translateY(-2px);
}
.action-card.active {
  border-color: var(--gold);
  background: linear-gradient(180deg, rgba(212, 165, 116, 0.04), var(--bg-card));
}

.action-num {
  font-family: 'Caveat', cursive; font-weight: 500;
  font-size: 2.4rem; color: var(--gold); line-height: 0.9;
}
.action-tag {
  font-family: 'Manrope', sans-serif; font-weight: 700;
  font-size: 0.68rem; letter-spacing: 0.2em; text-transform: uppercase;
  color: var(--cream-mute);
  white-space: nowrap; flex: none;
}
.action-tag.up-next { color: var(--gold); }
.action-title {
  font-family: 'Bricolage Grotesque', sans-serif;
  font-weight: 500; font-size: 1.25rem;
  letter-spacing: -0.015em; color: var(--cream);
}
.action-desc { color: var(--cream-soft); font-size: 0.98rem; line-height: 1.6; }

/* COPY button */
.copy-btn {
  background: var(--gold);
  color: var(--bg-deep);
  font-family: 'Manrope', sans-serif;
  font-weight: 700; font-size: 0.78rem;
  letter-spacing: 0.16em; text-transform: uppercase;
  padding: 10px 22px;
  border-radius: 999px;
  border: 1px solid var(--gold);
  cursor: pointer;
  transition: background 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
}
.copy-btn:hover {
  background: var(--gold-soft);
  box-shadow: 0 8px 24px rgba(212, 165, 116, 0.35);
  transform: translateY(-1px);
}

/* ─────────────────────────────────────────────────────────────────────
   Sidebar
   ───────────────────────────────────────────────────────────────────── */
.sidebar-section-label {
  font-family: 'Manrope', sans-serif; font-weight: 700;
  font-size: 0.68rem; letter-spacing: 0.2em; text-transform: uppercase;
  color: var(--cream-mute);
}
.sidebar-item {
  font-family: 'Bricolage Grotesque', sans-serif;
  font-weight: 500; font-size: 0.95rem;
  color: var(--cream-soft);
  border-left: 2px solid transparent;
  transition: all 0.15s ease;
}
.sidebar-item:hover { background: rgba(212, 165, 116, 0.04); color: var(--cream); }
.sidebar-item.active {
  background: var(--bg-elev);
  border-left-color: var(--gold);
  color: var(--cream);
}
.sidebar-badge {
  font-family: 'Caveat', cursive; font-weight: 500;
  font-size: 1.1rem; color: var(--gold);
}

/* ─────────────────────────────────────────────────────────────────────
   Vital tiles (Mission Control row)
   ───────────────────────────────────────────────────────────────────── */
.vital-tile {
  background: var(--bg-card);
  border: 1px solid var(--line-soft);
  border-radius: 8px;
  padding: 20px;
  display: flex; flex-direction: column; gap: 6px;
  box-shadow: var(--shadow-1);
  transition: border-color 0.2s ease, transform 0.2s ease;
}
.vital-tile:hover { border-color: var(--line); transform: translateY(-1px); }
.vital-tile .k {
  font-family: 'Manrope', sans-serif; font-weight: 700;
  font-size: 0.66rem; letter-spacing: 0.2em; text-transform: uppercase;
  color: var(--cream-mute);
}
.vital-tile .v {
  font-family: 'Bricolage Grotesque', sans-serif;
  font-weight: 500; font-size: 1.05rem;
  letter-spacing: -0.01em; color: var(--cream);
}
.vital-tile .v em {
  font-family: 'Caveat', cursive; font-style: normal;
  color: var(--gold); font-size: 1.4em; font-weight: 500;
}
.vital-tile .sub {
  font-family: 'JetBrains Mono', monospace; font-size: 0.7rem;
  color: var(--cream-dim);
}

.status-dot {
  width: 8px; height: 8px; border-radius: 50%;
  display: inline-block;
}
.status-dot.ok { background: var(--emerald); box-shadow: 0 0 8px var(--emerald); }
.status-dot.warn { background: var(--gold); box-shadow: 0 0 8px var(--gold); }
.status-dot.err { background: var(--plum); box-shadow: 0 0 8px var(--plum); }
.status-dot.info { background: var(--gold-soft); box-shadow: 0 0 8px var(--gold-soft); }

/* ─────────────────────────────────────────────────────────────────────
   Pull quotes
   ───────────────────────────────────────────────────────────────────── */
blockquote {
  margin: 48px 0; padding: 0 0 0 28px;
  border-left: 2px solid var(--gold);
  font-family: 'Bricolage Grotesque', sans-serif;
  font-weight: 300; font-size: 1.55rem;
  line-height: 1.42; color: var(--cream);
  letter-spacing: -0.018em;
}
blockquote cite {
  display: block; margin-top: 18px;
  font-family: 'Manrope', sans-serif; font-weight: 600;
  font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--gold); font-style: normal;
}

/* ─────────────────────────────────────────────────────────────────────
   ✦ Section dividers between major page blocks
   ───────────────────────────────────────────────────────────────────── */
.divider {
  display: flex; align-items: center; justify-content: center;
  margin: 70px 0; gap: 24px;
}
.divider .ornament {
  color: var(--gold); opacity: 0.7;
  font-family: 'Caveat', cursive; font-size: 1.6rem;
}
.divider .rule { flex: 1; height: 1px; background: var(--line); max-width: 160px; }

/* ─────────────────────────────────────────────────────────────────────
   Mascot card (Athena/Owl portrait holder)
   ───────────────────────────────────────────────────────────────────── */
.mascot-wrap {
  position: relative;
  background: radial-gradient(ellipse at center, rgba(212,165,116,0.12), transparent 60%);
  padding: 8px;
}
.mascot-card {
  background: var(--bg-card);
  border: 1px solid var(--line);
  border-radius: 8px;
  padding: 0; overflow: hidden;
  box-shadow: var(--shadow-2);
}
.mascot-card img { width: 100%; height: auto; display: block; }

/* ─────────────────────────────────────────────────────────────────────
   Glass `.panel` (reused everywhere) — reskinned to aubergine + gold
   ───────────────────────────────────────────────────────────────────── */
.panel {
  background: linear-gradient(180deg, rgba(37, 29, 44, 0.85), rgba(28, 22, 34, 0.7));
  border: 1px solid var(--line-soft);
  border-radius: 10px;
  backdrop-filter: blur(14px) saturate(120%);
  -webkit-backdrop-filter: blur(14px) saturate(120%);
  position: relative;
  overflow: hidden;
  box-shadow: var(--shadow-1);
}
.panel::before {
  content: "";
  position: absolute;
  inset: 0;
  background:
    radial-gradient(120% 60% at 0% 0%, rgba(212,165,116,0.06), transparent 60%);
  pointer-events: none;
}
.panel-hot { border-color: var(--line); }
.panel-hover { transition: border-color .25s ease, transform .25s ease; }
.panel-hover:hover { border-color: var(--line); transform: translateY(-1px); }

/* ─────────────────────────────────────────────────────────────────────
   Pills — small status chips
   ───────────────────────────────────────────────────────────────────── */
.pill {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 3px 11px; border-radius: 999px;
  font-size: 10.5px; letter-spacing: 0.16em;
  background: rgba(243,235,218,0.04);
  border: 1px solid var(--line-soft);
  font-family: 'JetBrains Mono', ui-monospace, monospace;
  text-transform: uppercase;
  color: var(--cream-dim);
  white-space: nowrap; flex: none;
}
.pill-ok   { color: var(--emerald);   border-color: rgba(90, 184, 150, 0.30); background: rgba(90, 184, 150, 0.06); }
.pill-warn { color: var(--gold);      border-color: rgba(212, 165, 116, 0.30); background: rgba(212, 165, 116, 0.06); }
.pill-err  { color: var(--plum);      border-color: rgba(196, 96, 126, 0.30); background: rgba(196, 96, 126, 0.06); }
.pill-info { color: var(--gold-soft); border-color: rgba(230, 198, 154, 0.30); background: rgba(212, 165, 116, 0.06); }

/* ─────────────────────────────────────────────────────────────────────
   Heartbeat dot + metric numerals
   ───────────────────────────────────────────────────────────────────── */
.heartbeat {
  width: 8px; height: 8px; border-radius: 50%;
  background: currentColor; box-shadow: 0 0 10px currentColor;
  animation: pulse 1.6s ease-in-out infinite;
}
@keyframes pulse {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(0.7); opacity: 0.4; }
}

.metric {
  font-family: 'JetBrains Mono', ui-monospace, monospace;
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
}

/* Minimal scrollbar */
.scroll::-webkit-scrollbar { width: 8px; height: 8px; }
.scroll::-webkit-scrollbar-thumb { background: rgba(212, 165, 116, 0.18); border-radius: 4px; }
.scroll::-webkit-scrollbar-thumb:hover { background: rgba(212, 165, 116, 0.32); }
.scroll::-webkit-scrollbar-track { background: transparent; }

/* Agent glow utility — keeps existing class names alive */
.glow-c { color: var(--rust);     text-shadow: 0 0 18px rgba(201, 124, 94, 0.5); }
.glow-o { color: var(--plum);     text-shadow: 0 0 18px rgba(196, 96, 126, 0.5); }
.glow-h { color: var(--gold-soft);text-shadow: 0 0 18px rgba(230, 198, 154, 0.5); }

/* Heading strip used by Panel.tsx header */
.heading-strip {
  position: relative;
  padding-left: 12px;
  font-family: 'Bricolage Grotesque', sans-serif;
  font-weight: 500;
  letter-spacing: -0.015em;
}
.heading-strip::before {
  content: "";
  position: absolute;
  left: 0; top: 4px; bottom: 4px;
  width: 2px; border-radius: 2px;
  background: var(--gold);
  opacity: 0.85;
  box-shadow: 0 0 10px var(--gold);
}

/* Command palette */
.cmdk-input {
  background: transparent; outline: none; border: none;
  width: 100%; padding: 16px 18px; color: var(--cream);
  font-family: 'Manrope', sans-serif; font-size: 15px;
}
.cmdk-item {
  display: flex; align-items: center; gap: 10px;
  padding: 10px 14px; border-radius: 6px;
  cursor: pointer; color: var(--cream-soft);
}
.cmdk-item[data-selected="true"] {
  background: rgba(212, 165, 116, 0.08);
  color: var(--cream);
}

/* Activity stream fade */
.stream-fade {
  mask-image: linear-gradient(to bottom, transparent, black 8%, black 92%, transparent);
}

/* Live tick bars */
.tick {
  display: inline-block;
  width: 4px; height: 12px; margin: 0 1px;
  background: currentColor; border-radius: 1px;
  opacity: 0.4;
}
.tick.live { animation: tick 1.4s ease-in-out infinite; }
@keyframes tick {
  0%, 100% { transform: scaleY(0.4); opacity: 0.4; }
  50% { transform: scaleY(1); opacity: 1; }
}

/* Aurora element exists in layout — silence it; the design system uses
   ambient gradients on body::after instead */
.aurora { display: none !important; }

/* Fusion Boardroom — deliberating animations */
@keyframes fusionShimmer { 0% { transform: translateX(-120%); } 100% { transform: translateX(320%); } }
.fusion-shimmer { animation: fusionShimmer 1.3s ease-in-out infinite; }
@keyframes fusionBlink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }
.fusion-caret { animation: fusionBlink 1s step-end infinite; color: #d4a574; }

/* Hermes / agent chat — render markdown replies tightly inside the bubble
   (fixes raw ** asterisks, lists, code, headings showing as plain text) */
.chat-md > :first-child { margin-top: 0; }
.chat-md > :last-child { margin-bottom: 0; }
.chat-md p { margin: 0 0 0.5em; }
.chat-md strong { font-weight: 700; color: var(--fg); }
.chat-md em { font-style: italic; }
.chat-md ul, .chat-md ol { margin: 0.3em 0 0.6em; padding-left: 1.25em; }
.chat-md li { margin: 0.15em 0; }
.chat-md li > p { margin: 0; }
.chat-md h1, .chat-md h2, .chat-md h3, .chat-md h4 {
  font-weight: 700; line-height: 1.25; margin: 0.7em 0 0.35em; color: var(--fg);
}
.chat-md h1 { font-size: 1.15em; }
.chat-md h2 { font-size: 1.1em; }
.chat-md h3, .chat-md h4 { font-size: 1.02em; }
.chat-md a { color: var(--accent-cyan, #00ccff); text-decoration: underline; }
.chat-md code {
  font-family: var(--font-geist-mono, ui-monospace), monospace; font-size: 0.92em;
  background: rgba(255,255,255,0.08); padding: 0.08em 0.36em; border-radius: 5px;
}
.chat-md pre {
  background: rgba(0,0,0,0.35); border: 1px solid var(--panel-border, rgba(255,255,255,0.1));
  border-radius: 10px; padding: 10px 12px; margin: 0.5em 0; overflow-x: auto;
}
.chat-md pre code { background: none; padding: 0; font-size: 0.86em; }
.chat-md blockquote {
  border-left: 3px solid var(--panel-border, rgba(255,255,255,0.2));
  margin: 0.5em 0; padding-left: 0.8em; color: var(--fg-dim);
}
.chat-md table { border-collapse: collapse; margin: 0.5em 0; font-size: 0.95em; }
.chat-md th, .chat-md td { border: 1px solid var(--panel-border, rgba(255,255,255,0.12)); padding: 4px 9px; }
.chat-md hr { border: 0; border-top: 1px solid var(--panel-border, rgba(255,255,255,0.12)); margin: 0.7em 0; }

/* Hermes pet — animated petdex sprite that mirrors the agent's live state.
   6-frame horizontal cycle per state row; row is set inline per state. */
@keyframes petBob { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-4px); } }
.hermes-pet {
  image-rendering: pixelated;
  pointer-events: none;
  display: block;
  filter: drop-shadow(0 6px 12px rgba(0,0,0,0.45));
  animation: petBob 2.4s ease-in-out infinite;
}
.hermes-pet-dock {
  position: absolute; right: 18px; bottom: 92px; z-index: 5;
  width: fit-content; height: fit-content;
  display: flex; flex-direction: column; align-items: center; gap: 2px;
}
.hermes-pet-dock .pet-state {
  font-family: var(--font-geist-mono, ui-monospace), monospace;
  font-size: 9px; letter-spacing: 0.14em; text-transform: uppercase;
  color: var(--fg-dim); opacity: 0.75;
}

/* ── Mobile responsiveness pass (2026-08-03) ───────────────────────── */
@media (max-width: 767px) {
  .owner-banner { display: none !important; }
  .page-subtitle { font-size: 0.92rem; margin-top: 8px; }
  .surface-card { border-radius: 14px; }
  table { display: block; overflow-x: auto; }
  pre { overflow-x: auto; }
  /* the pet sits over the composer on a narrow screen — shrink it and tuck it into the corner */
  .hermes-pet-dock { right: 6px; bottom: 118px; opacity: 0.85; transform: scale(0.6); transform-origin: bottom right; }
  /* 70px dividers + 40px stack gaps read as elegant on a 1500px canvas and as dead
     scrolling on a 390px one — tighten the whole vertical rhythm for phones */
  .divider { margin: 30px 0; gap: 14px; }
  .divider .rule { max-width: 70px; }
  .space-y-10 > :not([hidden]) ~ :not([hidden]) { margin-top: 1.6rem; }
}

/* ─────────────────────────────────────────────────────────────────────
   Scroll-rail — chip/tab strips that must never clip on a phone
   ───────────────────────────────────────────────────────────────────── */
.scroll-rail {
  overflow-x: auto; overflow-y: hidden;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  flex-wrap: nowrap;
  min-width: 0;
}
.scroll-rail::-webkit-scrollbar { display: none; }
.scroll-rail > * { flex: none; }
@media (min-width: 1024px) {
  .scroll-rail { overflow: visible; flex-wrap: wrap; }
}

/* Local chat markdown (assistant replies incl. Maple reasoning engine) */
.local-md > *:first-child { margin-top: 0; }
.local-md > *:last-child { margin-bottom: 0; }
.local-md p { margin: 0.45em 0; }
.local-md h1, .local-md h2, .local-md h3, .local-md h4 { font-size: 1em; font-weight: 700; color: var(--cream); margin: 0.7em 0 0.3em; }
.local-md ul, .local-md ol { margin: 0.4em 0; padding-left: 1.25em; }
.local-md li { margin: 0.18em 0; }
.local-md code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.88em; background: rgba(0,0,0,0.35); border: 1px solid var(--line-soft); border-radius: 5px; padding: 0.1em 0.35em; color: #e6c69a; }
.local-md pre { background: rgba(0,0,0,0.4); border: 1px solid var(--line-soft); border-radius: 10px; padding: 10px 12px; overflow-x: auto; margin: 0.5em 0; }
.local-md pre code { background: none; border: 0; padding: 0; color: #bae6fd; }
.local-md strong { color: var(--cream); }
.local-md table { border-collapse: collapse; margin: 0.5em 0; font-size: 0.92em; }
.local-md th, .local-md td { border: 1px solid var(--line-soft); padding: 4px 9px; }
.local-md blockquote { border-left: 2px solid var(--line-soft); margin: 0.5em 0; padding-left: 0.8em; color: var(--cream-mute); }
.local-md hr { border: 0; border-top: 1px solid var(--line-soft); margin: 0.7em 0; }

/* ── Mobile dopamine layer (IG-video look) — phones only ─────────────── */
.fx-aurora{position:fixed;inset:-20%;z-index:1;pointer-events:none;opacity:.55;filter:blur(46px);
  background:
    radial-gradient(34% 26% at 18% 82%, rgba(255,110,50,.30), transparent 70%),
    radial-gradient(30% 24% at 84% 14%, rgba(192,132,252,.26), transparent 70%),
    radial-gradient(26% 22% at 76% 70%, rgba(127,224,189,.20), transparent 70%);
  animation:fxAurora 13s ease-in-out infinite alternate}
@keyframes fxAurora{
  0%{transform:translate3d(-2%,1%,0) rotate(0deg);filter:blur(46px) hue-rotate(0deg)}
  50%{transform:translate3d(2%,-2%,0) rotate(3deg)}
  100%{transform:translate3d(-1%,2%,0) rotate(-3deg);filter:blur(46px) hue-rotate(38deg)}}
@media (max-width: 1180px) {
  /* animated gradient edge on every card */
  .surface-card::after,.panel::after{
    content:"";position:absolute;inset:0;border-radius:inherit;padding:1px;pointer-events:none;
    background:linear-gradient(120deg,rgba(255,138,60,.55),rgba(255,215,0,.4),rgba(127,224,189,.45),rgba(192,132,252,.5),rgba(255,138,60,.55));
    background-size:300% 300%;animation:fxEdge 7s linear infinite;
    -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);
    -webkit-mask-composite:xor;mask-composite:exclude;opacity:.72}
  /* fire line riding the top of the bottom nav */
  nav.md\:hidden.\!fixed::before{
    content:"";position:absolute;top:-2px;left:0;right:0;height:2px;
    background:linear-gradient(90deg,transparent,#ff8a3c,#ffd700,#7fe0bd,#c084fc,#ff8a3c,transparent);
    background-size:300% 100%;animation:fxFire 6s linear infinite;opacity:.9;
  }
  /* page titles get a living gradient shimmer */
  .page-title{
    background:linear-gradient(100deg,var(--cream) 30%,#ffd700 46%,#ff8a3c 52%,var(--cream) 68%);
    background-size:220% 100%;-webkit-background-clip:text;background-clip:text;
    -webkit-text-fill-color:transparent;animation:fxShimmer 3.6s ease-in-out infinite;
  }
  /* cards breathe neon */
  .surface-card,.panel{position:relative;animation:fxBreathe 5s ease-in-out infinite}
  .surface-card:nth-of-type(2n),.panel:nth-of-type(2n){animation-delay:2.5s}
  /* eyebrow numerals glow */
  .eyebrow-num,.action-tag{text-shadow:0 0 14px rgba(230,198,154,.55)}
  /* active bottom-nav item pulses */
  nav.md\:hidden a[style*="background"]{animation:fxNavPulse 2.4s ease-in-out infinite;border-radius:12px}
}
@keyframes fxEdge{0%{background-position:0% 50%}100%{background-position:300% 50%}}
@keyframes fxFire{0%{background-position:0% 0}100%{background-position:300% 0}}
@keyframes fxShimmer{0%,100%{background-position:0% 0}50%{background-position:120% 0}}
@keyframes fxBreathe{0%,100%{box-shadow:0 0 0 0 rgba(255,138,60,0)}50%{box-shadow:0 0 26px -6px rgba(255,138,60,.28),0 0 34px -10px rgba(192,132,252,.22)}}
@keyframes fxNavPulse{0%,100%{box-shadow:0 0 0 0 rgba(255,215,0,0)}50%{box-shadow:0 0 16px -2px rgba(255,215,0,.45)}}
@media (prefers-reduced-motion: reduce){
  .page-title,.surface-card,.panel{animation:none!important}
  .surface-card::after,.panel::after,.fx-aurora{animation:none!important;display:none}
  nav.md\:hidden.\!fixed::before{animation:none!important}
}
