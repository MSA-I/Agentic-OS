{
  "name": "agentic-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "launch": "node scripts/launch-agent-os.mjs",
    "control-plane:baseline": "node scripts/control-plane/collect-baseline.mjs",
