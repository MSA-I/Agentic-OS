    "control-plane:frozen-surfaces:check": "node scripts/control-plane/generate-frozen-surfaces.mjs --check",
    "test:unit": "node --experimental-strip-types --test",
    "verify:wave1-freeze": "node scripts/control-plane/verify-wave1-execution-freeze.mjs",
    "verify:workbench-route": "node scripts/verify-workbench-route-distribution.mjs",
    "verify:wave0-clean-tree": "node scripts/control-plane/verify-wave0-clean-tree.mjs",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "pretest:e2e:smoke": "npm run build",
    "test:e2e:smoke": "playwright test tests/e2e/routes.smoke.spec.ts",
    "pretest:a11y": "npm run build",
